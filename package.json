    "vite-plugin-pwa": "^1.3.0",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@types/eslint-config-prettier": "^6.11.3",
    "@types/mithril": "^2.2.8",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "sass-embedded": "^1.99.0",
    "sinon": "^22.0.0",
    "sinon-chai": "^4.0.1",
    "sinon-matchers": "^2.1.0",
    "workbox-build": "^7.4.1"
